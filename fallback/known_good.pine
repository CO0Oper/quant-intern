//@version=5
strategy("Quant Intern Known Good EMA Cross", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, pyramiding=0)

fastEma = ta.ema(close, 20)
slowEma = ta.ema(close, 50)

longSignal = ta.crossover(fastEma, slowEma)
exitSignal = ta.crossunder(fastEma, slowEma)

if longSignal
    strategy.entry("Long", strategy.long)

if exitSignal
    strategy.close("Long")

longStop = strategy.position_avg_price * 0.98
longTarget = strategy.position_avg_price * 1.03
strategy.exit("Long Risk Exit", "Long", stop=longStop, limit=longTarget)

plot(fastEma, "EMA 20", color=color.teal)
plot(slowEma, "EMA 50", color=color.orange)
